{
  "name": "@fangchenghao/dsh-web-search",
  "version": "0.10.0",
  "description": "DSH bundle: a key-free web search provider. Leads with the anonymous AnySearch API and falls back to public result pages (DuckDuckGo, Bing, 360), merged by reciprocal-rank fusion with a bilingual region policy, an engine cooldown and a TTL cache.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./locale/*.json": "./locales/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "locales/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "web-fetch",
    "search",
    "bing",
    "anysearch"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  },
  "author": "fangchenghao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fangchenghao/dsh-web-search-bing.git"
  },
  "homepage": "https://github.com/fangchenghao/dsh-web-search-bing#readme",
  "bugs": {
    "url": "https://github.com/fangchenghao/dsh-web-search-bing/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
